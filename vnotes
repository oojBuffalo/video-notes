class Fail(Exception):
    """An error to show the user as one plain line."""


def stamp(seconds):
    """Formats seconds as a transcript time.

    Args:
        seconds: Offset from the start of the video.

    Returns:
        `mm:ss` under an hour, `h:mm:ss` from one hour on.
    """
    seconds = int(seconds)
    hours, minutes, rest = seconds // 3600, seconds % 3600 // 60, seconds % 60
    return f'{hours}:{minutes:02}:{rest:02}' if hours else f'{minutes:02}:{rest:02}'


def parse_time(text):
    """Reads a time the agent typed.

    Args:
        text: Seconds, `mm:ss` or `h:mm:ss`, with or without square brackets.

    Returns:
        The time in whole seconds.

    Raises:
        Fail: If the text is not a time.
    """
    parts = text.strip('[]').split(':')
    if len(parts) > 3 or not all(part.isdigit() for part in parts):
        raise Fail(f'Not a time: {text!r}. Use seconds, mm:ss or h:mm:ss.')
    seconds = 0
    for part in parts:
        seconds = seconds * 60 + int(part)
    return seconds


def caption_lines(data):
    """Turns a json3 caption file into transcript lines.

    Args:
        data: Parsed json3 captions.

    Returns:
        One `[mm:ss] text` string per caption that has text.
    """
    lines = []
    for event in data.get('events', []):
        text = ''.join(seg.get('utf8', '') for seg in event.get('segs', []))
        text = html.unescape(' '.join(text.split()))
        if text:
            lines.append(f"[{stamp(event['tStartMs'] / 1000)}] {text}")
    return lines


def whisper_lines(data):
    """Turns whisper-cli JSON output into transcript lines.

    Args:
        data: Parsed `whisper-cli -oj` output.

    Returns:
        One `[mm:ss] text` string per segment that has text.
    """
    return [f"[{stamp(seg['offsets']['from'] / 1000)}] {seg['text'].strip()}"
            for seg in data.get('transcription', []) if seg['text'].strip()]


def pick_tracks(info):
    """Orders the caption tracks worth trying, best first.

    Human captions in the video's language come first, then the automatic
    track of the spoken words (`-orig`), then other automatic tracks in that
    language.

    Args:
        info: yt-dlp's info for the video.

    Returns:
        A list of `(label, language code)` pairs for tracks that offer json3.
    """
    # ponytail: only the video's own language (English when unknown) is tried;
    # anything else falls through to transcription. Add a --lang flag if needed.
    base = (info.get('language') or 'en').split('-')[0]
    found = []
    for kind, tracks in (('human', info.get('subtitles') or {}),
                         ('automatic', info.get('automatic_captions') or {})):
        langs = [lang for lang in tracks if lang.split('-')[0] == base]
        if kind == 'human':
            langs.sort(key=lambda lang: (lang != base, lang))
        else:
            langs.sort(key=lambda lang: (not lang.endswith('-orig'), lang))
        for lang in langs:
            if any(f.get('ext') == 'json3' for f in tracks[lang]):
                found.append((f'{lang} ({kind})', lang))
    return found


def pick_streams(formats, height):
    """Chooses the video streams to read frames from.

    Args:
        formats: yt-dlp's format list for the video.
        height: Tallest picture wanted, in pixels.

    Returns:
        Stream URLs to try in order: the best direct stream, then the best HLS
        stream. Empty when the video has no picture.
    """
    def best(protocols):
        video = [f for f in formats if f.get('url') and f.get('protocol') in protocols
                 and f.get('vcodec') not in (None, 'none')]
        fits = [f for f in video if (f.get('height') or 0) <= height]
        if fits:
            # avc1 decodes everywhere, so it wins a tie on height
            return max(fits, key=lambda f: (f.get('height') or 0, f['vcodec'].startswith('avc1')))['url']
        return min(video, key=lambda f: f.get('height') or 0)['url'] if video else None

    return [url for url in (best(('https', 'http')), best(('m3u8_native', 'm3u8'))) if url]


def run(command, timeout):
    """Runs a command without letting stream addresses reach the output.

    Args:
        command: Program and arguments.
        timeout: Seconds to wait before giving up.

    Returns:
        `(ok, stdout, error text)`. The error text has every URL removed.
    """
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, '', f'timed out after {timeout} s'
    return done.returncode == 0, done.stdout, scrub(done.stderr)


def scrub(text):
    """Removes addresses and anything shaped like an API key from text that will be shown.

    Args:
        text: An error message from a program or a server.

    Returns:
        The text with every URL and every `sk-...` key replaced.
    """
    return re.sub(r'\bsk-[\w*.-]+', '<key>', re.sub(r'https?://\S+', '<url>', text)).strip()


@functools.lru_cache
def newest_ytdlp():
    """Finds the newest yt-dlp on PATH; an old copy often fails on current sites.

    Returns:
        Path of the yt-dlp with the highest version.

    Raises:
        Fail: If there is no yt-dlp on PATH.
    """
    found = {}
    for folder in os.get_exec_path():
        path = os.path.join(folder, 'yt-dlp')
        if os.path.isfile(path) and os.access(path, os.X_OK):
            version = tuple(int(n) for n in re.findall(r'\d+', run([path, '--version'], 30)[1]))
            found.setdefault(version, path)
    if not found:
        raise Fail('yt-dlp is not installed or not on PATH.')
    return found[max(found)]


def ytdlp(*args, timeout=180):
    """Runs the newest yt-dlp, ignoring the user's yt-dlp config.

    Args:
        *args: Arguments after the fixed safe ones.
        timeout: Seconds to wait.

    Returns:
        `(ok, stdout, error text)` as from `run`.
    """
    return run([newest_ytdlp(), '--ignore-config', '--no-warnings', '--no-playlist', *args], timeout)


def video_info(url):
    """Asks yt-dlp for everything it knows about a video.

    Args:
        url: The video page.

    Returns:
        yt-dlp's info dictionary.

    Raises:
        Fail: If yt-dlp cannot read the page.
    """
    ok, out, error = ytdlp('-J', '--', url)
    if not ok:
        raise Fail(f'yt-dlp could not read {url}: {error[-300:]}')
    return json.loads(out)


def transcribe(url, language):
    """Downloads the audio and transcribes it with whisper-cli.

    Args:
        url: The video page.
        language: Spoken language code, or `auto`.

    Returns:
        Transcript lines.

    Raises:
        Fail: If whisper-cli or its model file is missing, or a step fails.
    """
    cli = shutil.which('whisper-cli')
    if not cli:
        raise Fail('No usable captions, and whisper-cli is not installed, so the audio cannot be transcribed.')
    model = os.environ.get('VNOTES_WHISPER_MODEL') or next(
        (str(path) for folder in MODEL_DIRS for path in sorted(Path(folder).glob('ggml-*.bin'))), '')
    if not os.path.isfile(model):
        raise Fail('No usable captions, and no whisper model file. Set VNOTES_WHISPER_MODEL to a '
                   f'ggml-*.bin file (looked in {", ".join(MODEL_DIRS)}).')
    with tempfile.TemporaryDirectory() as tmp:
        ok, _, error = ytdlp('-f', 'ba/b', '-x', '--audio-format', 'wav', '--postprocessor-args',
                             'ffmpeg:-ar 16000 -ac 1', '-o', f'{tmp}/audio.%(ext)s', '--', url, timeout=3600)
        if not ok:
            raise Fail(f'Could not download the audio: {error[-300:]}')
        whisper = [cli, '-m', model, '-f', f'{tmp}/audio.wav', '-l', language, '-oj', '-of', f'{tmp}/out']
        ok, _, error = run(whisper, 4 * 3600)
        if not ok:  # a sandbox can block the GPU; the CPU is slower but works
            print('whisper-cli failed on the GPU. Trying again on the CPU, which is slower.', file=sys.stderr)
            ok, _, error = run([*whisper, '-ng'], 12 * 3600)
        if not ok:
            raise Fail(f'whisper-cli failed: {error[-300:]}')
        return whisper_lines(json.loads(Path(tmp, 'out.json').read_text()))


def sheet_starts(length):
    """Lists where each index sheet starts.

    Args:
        length: Length of the video in seconds.

    Returns:
        One start time in seconds per sheet: `ceil(length / SPAN)` of them, so
        the last partial stretch of the video gets a sheet too.
    """
    return list(range(0, math.ceil(length), SPAN))


def index_sheets(info, out):
    """Writes low-resolution contact sheets covering the whole timeline.

    Args:
        info: yt-dlp's info for the video.
        out: The notes folder.

    Returns:
        Sheet paths in time order. Empty when the video has no picture.

    Raises:
        Fail: If the video has a picture but no stream could be read.
    """
    if not pick_streams(info.get('formats') or [], 240):
        return []
    folder, build = out / 'index', out / 'index.part'  # the old index stays until a new one is complete
    grid = f'fps=1/{EVERY},{FIT.format(320, 180)},tile={COLS}x{ROWS}:padding=4:color=white'
    with tempfile.TemporaryDirectory() as tmp:
        # yt-dlp downloads a small copy first. Reading the remote stream with ffmpeg is throttled:
        # one five-minute sheet of an 82-minute video took 150 s that way, and 0.2 s from a local file.
        Path(tmp, 'info.json').write_text(json.dumps(info))
        ok, _, error = ytdlp('--load-info-json', f'{tmp}/info.json', '-f',
                             'bv*[height<=240][vcodec^=avc1]/bv*[height<=240]/wv*/w',
                             '-o', f'{tmp}/video.%(ext)s', timeout=3600)
        videos = [path for path in Path(tmp).glob('video.*') if path.suffix != '.part']
        if not ok or not videos:
            raise Fail(f'Could not download the low-resolution video for the index: {error[-300:]}')
        try:  # the file's own length decides the sheets; the site's figure is a rounded fallback
            length = float(run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
                                '-of', 'csv=p=0', str(videos[0])], 120)[1])
        except ValueError:
            length = info.get('duration')
        if not length:
            raise Fail('Could not find out how long the video is, so the index cannot be built.')
        shutil.rmtree(build, ignore_errors=True)
        build.mkdir()

        def sheet(start):
            target = build / f'index-{start // 60:03}m.jpg'
            ok, _, error = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-ss', str(start), '-t', str(SPAN),
                                '-i', str(videos[0]), '-vf', grid, '-frames:v', '1', '-update', '1', '-q:v', '4',
                                '-y', str(target)], 600)
            good = ok and target.exists() and target.stat().st_size
            return (target.name, '') if good else (None, error or 'no picture came back')

        with ThreadPoolExecutor(8) as pool:
            results = list(pool.map(sheet, sheet_starts(length)))
    failed = [error for name, error in results if not name]
    # ponytail: a last sheet with less than one frame of video comes back empty and fails the index
    if failed or len(results) != math.ceil(length / SPAN):
        shutil.rmtree(build, ignore_errors=True)
        raise Fail(f'Could not build {len(failed)} of {math.ceil(length / SPAN)} index sheets: '
                   f'{(failed or ["wrong sheet count"])[0][-300:]}')
    shutil.rmtree(folder, ignore_errors=True)
    build.rename(folder)
    return [folder / name for name, _ in results]


def fetch(url, out=None, force_transcribe=False):
    """Writes meta.json, transcript.txt and the index sheets for a video.

    Args:
        url: The video page.
        out: Folder to write into. Defaults to `notes-<video id>`.
        force_transcribe: Transcribe the audio even when captions exist.

    Returns:
        The folder written.

    Raises:
        Fail: If the video, its words or its index cannot be fetched.
    """
    info = video_info(url)
    out = Path(out or f"notes-{info['id']}")
    out.mkdir(parents=True, exist_ok=True)
    lines, source, problem = [], None, ''
    tracks = [] if force_transcribe else pick_tracks(info)
    with tempfile.TemporaryDirectory() as tmp:
        # yt-dlp downloads the captions: a plain HTTP read of a long track gets cut off
        Path(tmp, 'info.json').write_text(json.dumps(info))
        for source, lang in tracks:
            problem = ytdlp('--load-info-json', f'{tmp}/info.json', '--skip-download', '--write-subs',
                            '--write-auto-subs', '--sub-langs', lang, '--sub-format', 'json3', '-o', f'{tmp}/cap')[2]
            try:
                lines = caption_lines(json.loads(Path(tmp, f'cap.{lang}.json3').read_text()))
            except (OSError, ValueError):
                continue
            if lines:
                break
    if not lines:
        if tracks:
            print(f'Captions exist ({tracks[0][0]}) but could not be downloaded: {problem[-200:]}', file=sys.stderr)
        print('Transcribing the audio. This takes longer than reading captions.', file=sys.stderr)
        lines = transcribe(url, (info.get('language') or 'auto').split('-')[0])
        source = 'whisper-cli transcription'
        if not lines:
            raise Fail('The audio was transcribed but no speech was found, so there are no words to make notes from.')
    meta = {key: info.get(key) for key in
            ('id', 'title', 'uploader', 'duration', 'upload_date', 'chapters', 'description')}
    meta.update(url=info.get('webpage_url') or url, words=source)
    (out / 'meta.json').write_text(json.dumps(meta, indent=1, ensure_ascii=False) + '\n')
    (out / 'transcript.txt').write_text('\n'.join(lines) + '\n')
    print(f'{out}/meta.json')
    print(f'{out}/transcript.txt  {len(lines)} lines from {source}')
    sheets = index_sheets(info, out)
    if not sheets:
        print('No picture in this video, so no index sheets.')
        return out
    print(f'{len(sheets)} index sheets: one tile every {EVERY} s, {COLS} tiles per row, so each row is one minute.')
    for n, sheet in enumerate(sheets):
        print(f'{sheet}  starts {stamp(n * SPAN)}')
    return out


def frames(out, times, url=None):
    """Writes full-size frames at the given times, plus contact sheets.

    Args:
        out: A folder that `fetch` has filled.
        times: Times as typed: seconds, `mm:ss` or `h:mm:ss`.
        url: The video page. Defaults to the one recorded in meta.json.

    Returns:
        Process exit code: 0 when every frame arrived, 1 otherwise.

    Raises:
        Fail: If the folder was not fetched, a time is malformed, or the video
            has no picture.
    """
    out = Path(out)
    try:
        meta = json.loads((out / 'meta.json').read_text())
        url = url or meta['url']
    except (OSError, ValueError, KeyError):
        raise Fail(f'{out}/meta.json is missing or unreadable. Run `vnotes fetch URL {out}` first.') from None
    seconds = sorted({parse_time(text) for text in times})
    length = meta.get('duration')
    if length and seconds[-1] >= length:  # ffmpeg would return the last frame for these
        raise Fail(f'{stamp(seconds[-1])} is past the end of the video ({stamp(length)}).')
    # ponytail: the signed stream address is resolved again on every call (about
    # 6 s) and never written to disk. Cache it if that wait starts to matter.
    streams = pick_streams(video_info(url).get('formats') or [], 1080)
    if not streams:
        raise Fail('This video has no picture to take frames from.')
    folder = out / 'frames'
    folder.mkdir(exist_ok=True)

    def grab(second):
        path = folder / f"{stamp(second).replace(':', '-')}.jpg"
        part = path.with_suffix('.part.jpg')  # an existing frame is replaced only by a good new one
        errors = []
        for stream in streams * 3:  # stream reads drop at random; a retry usually works
            ok, _, error = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-ss', str(second), '-i', stream,
                                '-frames:v', '1', '-update', '1', '-q:v', '2', '-y', str(part)], 90)
            if ok and part.exists() and part.stat().st_size:
                os.replace(part, path)
                return path, ''
            errors.append(error.splitlines()[-1] if error else 'no picture came back')
        part.unlink(missing_ok=True)
        return None, '; '.join(dict.fromkeys(errors))

    with ThreadPoolExecutor(8) as pool:
        results = list(pool.map(grab, seconds))
    got = [(second, path) for second, (path, _) in zip(seconds, results) if path]
    missed = [f'{stamp(second)} ({error})' for second, (path, error) in zip(seconds, results) if not path]
    first = len(list(folder.glob('sheet-*.jpg'))) + 1
    with tempfile.TemporaryDirectory() as tmp:
        for n, (_, path) in enumerate(got):
            os.symlink(path.resolve(), f'{tmp}/{n:04}.jpg')
        ok, _, error = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-start_number', '0',
                            '-i', f'{tmp}/%04d.jpg', '-vf', f'{FIT.format(640, 360)},tile=4x3:padding=6:color=white',
                            '-q:v', '3', '-start_number', str(first), str(folder / 'sheet-%02d.jpg')], 300)
    if got and not ok:
        print(f'Could not build a contact sheet ({error[-200:]}); the frames are still there.')
    for n in range(0, len(got) if ok else 0, 12):
        print(f'{folder}/sheet-{first + n // 12:02}.jpg  tiles in time order, left to right, top to bottom:')
        for row in range(n, min(n + 12, len(got)), 4):
            print('  ' + '  '.join(stamp(second) for second, _ in got[row:row + 4]))
    if got:
        print(f'Full-size frames are in {folder}/, named by time, for example {got[0][1].name}.')
    for line in missed:
        print(f'Could not get {line}')
    return 1 if missed else 0


def ask(agent, message, out):
    """Runs one headless turn in which the agent can look at files and do nothing else.

    Args:
        agent: `claude` or `codex`.
        message: The whole prompt.
        out: The notes folder, used as the working folder.

    Returns:
        The agent's final reply.

    Raises:
        Fail: If the harness fails or says nothing.
    """
    if agent == 'claude':
        # Read is the only tool, confined to the folder; no user settings, plugins, hooks or MCP servers
        done = subprocess.run(['claude', '-p', '--tools', 'Read', '--restricted', '--safe-mode',
                               '--strict-mcp-config', '--no-session-persistence'],
                              cwd=out, input=message, stdout=subprocess.PIPE, text=True)
        reply = done.stdout
    else:
        with tempfile.TemporaryDirectory() as tmp:
            last = Path(tmp, 'reply.md')
            done = subprocess.run(['codex', 'exec', '--ignore-user-config', '--ephemeral', '--skip-git-repo-check',
                                   '-s', 'read-only', *(flag for name in CODEX_OFF for flag in ('--disable', name)),
                                   '-c', 'web_search="disabled"', '-o', str(last), '-'],
                                  cwd=out, input=message, stdout=subprocess.DEVNULL, text=True)
            reply = last.read_text() if last.is_file() else ''
    if done.returncode or not reply.strip():
        # the harness prints its own error (login, refusal, rate limit) where the reply would be
        said = ' It said: ' + ' '.join(reply.split())[:300] if reply.strip() else ''
        raise Fail(f'{agent} gave no reply (exit code {done.returncode}).{said}')
    return reply.strip()


def local_images(text):
    """Lists the local file that each Markdown image in the text points at.

    Args:
        text: Markdown.

    Returns:
        The complete destination of every image, inline or reference-style,
        leaving out destinations with a URL scheme such as `https:`.
    """
    # ponytail: alt text with a `]` inside it, and a destination with a `)` inside it, are not parsed.
    # Use a Markdown parser if notes ever need those.
    place = r'(?:<([^<>\n]*)>|([^\s<)][^\s)]*))'  # `<a path with spaces>` or a path without spaces
    found = [angled or plain for angled, plain in re.findall(r'!\[[^\]]*\]\(\s*' + place, text)]
    defined = {label.strip().lower(): angled or plain
               for label, angled, plain in re.findall(r'^ {0,3}\[([^\]\n]+)\]:\s*' + place, text, re.M)}
    for alt, label in re.findall(r'!\[([^\]]*)\](?:\[([^\]]*)\])?(?!\()', text):  # ![alt][label], ![alt][], ![alt]
        found.append(defined.get((label or alt).strip().lower()))
    return [target for target in found if target and not re.match(r'[a-z][a-z0-9+.-]*:', target, re.I)]


def save_notes(out, text):
    """Saves notes.md, unless it links to images that are not files inside the notes folder.

    Args:
        out: The notes folder.
        text: The complete notes.

    Returns:
        The image links that point at no file, or at one outside the folder.
        Empty when the notes were saved.
    """
    root = out.resolve()  # a link must not reach outside the folder, even to a file that exists
    missing = sorted({target for target in local_images(text)
                      if not ((root / target).resolve().is_relative_to(root) and (root / target).is_file())})
    if not missing:
        part = out / 'notes.md.part'
        part.write_text(text + '\n')
        os.replace(part, out / 'notes.md')
        print(out / 'notes.md')
    return missing


def notes(url, request, agent, out):
    """Fetches a video, then runs the skill headless in an installed harness.

    The transcript and the pictures are untrusted text, so the agent can only
    read. It replies with either a frame request or the finished notes; this
    function pulls the frames and writes notes.md itself.

    Args:
        url: The video page.
        request: What the reader wants from the notes, or None.
        agent: `claude` or `codex`; uses that CLI's existing login.
        out: Folder to write into, or None for the default.

    Raises:
        Fail: If the harness is missing or never returns usable notes.
    """
    if not shutil.which(agent):
        raise Fail(f'{agent} is not installed or not on PATH.')
    out = fetch(url, out).resolve()
    sheets = '\n'.join(str(sheet) for sheet in sorted((out / 'index').glob('*.jpg'))) or 'none: the video has no picture'
    brief = (f'Write video notes by following the skill at the end of this message.\n\nURL: {url}\n'
             f'What the reader asked for: {request or "thorough study notes"}\n\n'
             f'You are running headless. You can look at files in {out} and do nothing else: '
             'no commands, no writing, no network.\n'
             'Step 1 is done. meta.json and transcript.txt are copied below. The index sheets are:\n'
             f'{sheets}\n\n'
             'A program reads your reply, in one of two ways:\n'
             '- To get frames (step 3), make the first line of your reply `FRAMES:` followed by the times, for '
             'example `FRAMES: 1:22 3:54 12:40`. Under that line write a handover: the outline of the notes '
             'so far and what each requested frame should show. A fresh session will be given that handover '
             'and the frames. Ask for the bracketing call the same way.\n'
             '- When the notes are finished (step 4), reply with the complete text of notes.md and nothing '
             'else: no preamble and no code fence. Your reply is saved as notes.md word for word. Link images '
             'as `frames/01-22.jpg`.\n\n')
    material = (f"## meta.json\n\n{(out / 'meta.json').read_text()}\n"
                f"## transcript.txt\n\n{(out / 'transcript.txt').read_text()}\n"
                + SKILL.read_text())
    progress = ''
    # ponytail: every turn is a fresh session that reads the material again, because not every
    # harness can resume one. Resume the session instead if the repeated reading costs too much.
    for turn in range(1, 7):
        reply = ask(agent, brief + progress + material, out)
        first, _, rest = reply.partition('\n')
        if first.upper().startswith('FRAMES:'):
            report = io.StringIO()
            try:
                with contextlib.redirect_stdout(report):
                    frames(out, first[len('FRAMES:'):].split(), url)
                outcome = report.getvalue()
            except Fail as error:
                outcome = f'The request did not work: {error}'
            print(outcome)
            progress += f'## Progress: turn {turn}\n\nYou replied:\n\n{reply}\n\nWhat happened:\n\n{outcome}\n\n'
            continue
        missing = save_notes(out, reply)
        if not missing:
            return
        outcome = f'Your notes were not saved. They link to images that do not exist: {", ".join(missing)}.'
        print(outcome)
        progress += (f'## Progress: turn {turn}\n\n{outcome} Ask for them with FRAMES:, or reply with the '
                     'full notes again without those links.\n\n')
    raise Fail(f'{agent} did not return usable notes in six turns.')


def encoded(path):
    """Reads an image as base64 text.

    Args:
        path: A JPEG file.

    Returns:
        The file's bytes in base64.
    """
    return base64.b64encode(path.read_bytes()).decode()


def responses_body(model, system, parts):
    """Builds a Responses request, the shape the ChatGPT login accepts.

    Args:
        model: Model id.
        system: The standing instruction.
        parts: Text strings and JPEG paths, in the order the model should see them.

    Returns:
        The request body.
    """
    content = [{'type': 'input_image', 'image_url': 'data:image/jpeg;base64,' + encoded(part)}
               if isinstance(part, Path) else {'type': 'input_text', 'text': part} for part in parts]
    return {'model': model, 'stream': True, 'store': False, 'reasoning': {'effort': EFFORT},
            'input': [{'type': 'message', 'role': 'developer', 'content': [{'type': 'input_text', 'text': system}]},
                      {'type': 'message', 'role': 'user', 'content': content}]}


def chat_body(model, system, parts):
    """Builds a Chat Completions request, for OpenAI, OpenRouter and compatible servers.

    Args:
        model: Model id.
        system: The standing instruction.
        parts: Text strings and JPEG paths, in the order the model should see them.

    Returns:
        The request body.
    """
    content = [{'type': 'image_url', 'image_url': {'url': 'data:image/jpeg;base64,' + encoded(part)}}
               if isinstance(part, Path) else {'type': 'text', 'text': part} for part in parts]
    return {'model': model, 'stream': True,
            'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': content}]}


def messages_body(model, system, parts):
    """Builds an Anthropic Messages request.

    Args:
        model: Model id.
        system: The standing instruction.
        parts: Text strings and JPEG paths, in the order the model should see them.

    Returns:
        The request body.
    """
    content = [{'type': 'image', 'source': {'type': 'base64', 'media_type': 'image/jpeg', 'data': encoded(part)}}
               if isinstance(part, Path) else {'type': 'text', 'text': part} for part in parts]
    # ponytail: no refusal fallback. A refused request stops the run with the reason.
    return {'model': model, 'max_tokens': 64000, 'stream': True, 'system': system,
            'output_config': {'effort': EFFORT}, 'messages': [{'role': 'user', 'content': content}]}


def connect(via):
    """Finds where a provider's requests go, how they are signed and how they are built.

    Args:
        via: `chatgpt`, `openai`, `openrouter`, `endpoint` or `anthropic`.

    Returns:
        `(address, credential headers, body builder)`.

    Raises:
        Fail: If the login or key for that provider is missing.
    """
    def env(name):
        if not os.environ.get(name):
            raise Fail(f'{name} is not set.')
        return os.environ[name]

    if via == 'chatgpt':
        try:  # the login Codex saved is read and never written
            tokens = json.loads(CODEX_AUTH.read_text())['tokens']
            headers = {'Authorization': 'Bearer ' + tokens['access_token'], 'chatgpt-account-id': tokens['account_id']}
        except (OSError, ValueError, KeyError, TypeError):
            raise Fail(f'No ChatGPT login in {CODEX_AUTH}. Run `codex login` first.') from None
        return URLS[via], headers, responses_body
    if via == 'anthropic':
        return URLS[via], {'x-api-key': env('ANTHROPIC_API_KEY'), 'anthropic-version': '2026-10-21'}, messages_body
    if via == 'endpoint':
        key = os.environ.get('VNOTES_API_KEY')
        return (env('VNOTES_BASE_URL').rstrip('/') + '/chat/completions',
                {'Authorization': 'Bearer ' + key} if key else {}, chat_body)
    return URLS[via], {'Authorization': 'Bearer ' + env(f'{via.upper()}_API_KEY')}, chat_body


def reply_text(lines):
    """Joins the reply out of a server-sent event stream in any of the three shapes.

    Args:
        lines: The response body, one bytes line at a time.

    Returns:
        The text the model wrote.

    Raises:
        Fail: If the model refused, ran out of room or was sent a bad request,
            or there is no text. Trying again would not help.
        ConnectionError: If the provider reported a passing fault, or the
            stream ended without the provider's end mark. Worth another try.
    """
    text, complete = [], False
    for line in lines:
        if not line.startswith(b'data:') or not line[5:].strip():
            continue
        if line[5:].strip() == b'[DONE]':
            complete = True
            continue
        event = json.loads(line[5:])
        kind, choices = event.get('type'), event.get('choices') or []
        if kind in ('error', 'response.failed', 'response.incomplete') or event.get('error'):
            answer = event.get('response') or {}
            problem = event.get('error') or answer.get('error') or answer.get('incomplete_details') or event
            label = f"{problem.get('type')} {problem.get('code')}" if isinstance(problem, dict) else ''
            if re.search(r'overloaded|server_error|api_error|rate_limit|timeout|unavailable|\b(429|5\d\d)\b', label):
                raise ConnectionError(f'the provider reported {json.dumps(problem)}')
            raise Fail(f'The model stopped with an error: {json.dumps(problem)}')
        stops = [choice.get('finish_reason') for choice in choices]
        if kind == 'message_delta':
            stops.append(event['delta'].get('stop_reason'))
        for stop in stops:
            if stop in ('length', 'max_tokens', 'refusal', 'content_filter'):
                raise Fail(f'The model did not finish its reply ({stop}).')
        complete = complete or kind in ('response.completed', 'message_stop') or bool({'stop', 'end_turn'} & set(stops))
        if kind == 'response.output_text.delta':
            text.append(event['delta'])
        elif kind == 'content_block_delta':
            text.append(event['delta'].get('text', ''))
        text += [(choice.get('delta') or {}).get('content') or '' for choice in choices]
    if not complete:  # a dropped connection must not pass for a finished reply
        raise ConnectionError('the reply stopped before the provider marked it complete')
    if not ''.join(text).strip():
        raise Fail('The model sent an empty reply.')
    return ''.join(text).strip()


def send(via, model, system, parts):
    """Sends one request to a model and returns what it wrote. The model gets no tools.

    Args:
        via: `chatgpt`, `openai`, `openrouter`, `endpoint` or `anthropic`.
        model: Model id.
        system: The standing instruction.
        parts: Text strings and JPEG paths (`Path`), in the order the model should see them.

    Returns:
        The reply text.

    Raises:
        Fail: If the credential is missing or refused, or no usable reply came back.
    """
    address, headers, build = connect(via)
    body = build(model, system, parts)
    if via in ('openai', 'openrouter'):  # ponytail: left out for `endpoint`, where a server may reject the field
        body['reasoning_effort'] = EFFORT
    request = urllib.request.Request(address, json.dumps(body).encode(), {
        **headers, 'Content-Type': 'application/json', 'Accept': 'text/event-stream', 'User-Agent': 'vnotes'})

    def clean(text):  # every error this function shows passes through here
        for name, secret in headers.items():
            if name != 'anthropic-version':  # a server that echoes a credential must not get it into the output
                text = text.replace(secret.split()[-1], '<secret>')
        return scrub(' '.join(text.split()))[:300]

    for wait in (5, 20, 60, None):  # three more tries after a busy or broken answer, each after a longer wait
        try:
            with urllib.request.urlopen(request, timeout=900) as response:
                return reply_text(response)
        except Fail as error:
            raise Fail(clean(str(error))) from None
        except urllib.error.HTTPError as error:
            status, problem = error.code, error.read().decode('utf-8', 'replace')
        except (OSError, http.client.HTTPException, ValueError) as error:  # dropped, cut short or garbled
            status, problem = 0, f'{type(error).__name__}: {error}'
        if wait is None or 0 < status < 500 and status != 429:
            break
        print(f'{via} answered {status or "nothing"}. Waiting {wait} s before trying again.', file=sys.stderr)
        time.sleep(wait)
    if via == 'chatgpt' and status == 401:
        # ponytail: the token is never refreshed here, because that would mean writing Codex's auth.json.
        raise Fail('The ChatGPT login was refused. Run `codex` once to renew the login.')
    raise Fail(f'The request to {via} failed ({status or "no connection"}): {clean(problem)}')


def frame_lines(plan):
    """Reads the frames a plan asks for.

    Args:
        plan: The model's plan, with `mm:ss | what it should show` lines.

    Returns:
        `(seconds, what the frame should show)` pairs in time order, one per time.
    """
    wanted = {}
    for when, what in re.findall(r'^[\s`*-]*\[?(\d+(?::\d\d){0,2})\]?\s*\|\s*(.+?)[\s`]*$', plan, re.M):
        wanted.setdefault(parse_time(when), what)
    return sorted(wanted.items())


def skill_part(number):
    """Returns one numbered section of the skill, so this route follows the same rules.

    Args:
        number: The section number in skill/SKILL.md.

    Returns:
        The section's text, heading included.
    """
    return re.search(rf'^## {number}\..*?(?=^## |\Z)', SKILL.read_text(), re.S | re.M).group()


def direct(url, request, via, model, out):
    """Fetches a video and writes its notes in fixed steps: plan, frames, write, check.

    The model is called three times and has no tools, so the transcript and
    the pictures can only affect the text of the notes.

    Args:
        url: The video page.
        request: What the reader wants from the notes, or None.
        via: `chatgpt`, `openai`, `openrouter`, `endpoint` or `anthropic`.
        model: Model id, or None for that provider's default.
        out: Folder to write into, or None for the default.

    Raises:
        Fail: If a credential is missing, a step fails, or the finished notes
            link to images that do not exist.
    """
    model = model or MODELS.get(via)
    if not model:
        raise Fail('--via endpoint needs --model.')
    connect(via)  # a missing key or login stops the run before the slow fetch
    out = fetch(url, out).resolve()
    meta = json.loads((out / 'meta.json').read_text())
    material = (f"What the reader asked for: {request or 'thorough study notes'}\n\n"
                f"## meta.json\n\n{(out / 'meta.json').read_text()}\n"
                f"## transcript.txt\n\n{(out / 'transcript.txt').read_text()}")
    sheets = sorted((out / 'index').glob('*.jpg'))
    start = time.monotonic()

    parts = [f'{PLAN}\n{skill_part(2)}\n{material}']
    for sheet in sheets:
        parts += [f'Index sheet {sheet.name}, starting at {stamp(int(sheet.stem[6:9]) * 60)}:', sheet]
    plan = send(via, model, SYSTEM, parts)
    (out / 'plan.md').write_text(plan + '\n')
    wanted = [(second, what) for second, what in frame_lines(plan) if second < (meta.get('duration') or math.inf)]
    if len(wanted) > MAX_FRAMES:  # spread the cut over the whole video instead of dropping its end
        wanted = [wanted[n * len(wanted) // MAX_FRAMES] for n in range(MAX_FRAMES)]
    print(f'Plan: {len(wanted)} frames wanted, after {time.monotonic() - start:.0f} s. Saved as {out}/plan.md')

    report = io.StringIO()
    if wanted and sheets:
        with contextlib.redirect_stdout(report):
            frames(out, [str(second) for second, _ in wanted], url)
    missed = [line for line in report.getvalue().splitlines() if line.startswith('Could not get')]
    pulled = []
    for second, what in wanted:
        frame = out / 'frames' / f"{stamp(second).replace(':', '-')}.jpg"
        if frame.is_file():
            pulled += [f'frames/{frame.name} at {stamp(second)}. Planned to show: {what}', frame]
    print(f'Frames: {len(pulled) // 2} of {len(wanted)} pulled, after {time.monotonic() - start:.0f} s.')
    draft = send(via, model, SYSTEM, [
        f'{WRITE}\n{skill_part(4)}\n{material}\n## Your plan\n\n{plan}\n\n' + '\n'.join(missed), *pulled])
    (out / 'draft.md').write_text(draft + '\n')
    print(f'Draft written, after {time.monotonic() - start:.0f} s. Saved as {out}/draft.md')

    # the check sees every pulled frame, not only the linked ones, so it can notice what the draft left out
    checked = send(via, model, SYSTEM, [f'{CHECK}\n## Draft of notes.md\n\n{draft}\n\n{material}', *pulled])
    print(f'Draft checked against {len(pulled) // 2} frames, after {time.monotonic() - start:.0f} s.')
    checked += (f"\n\n---\n\nWords: {meta.get('words')}. Index sheets sent to the model: {len(sheets)}. "
                f'Frames pulled and sent: {len(pulled) // 2}. Written by {model} via {via} with `vnotes direct`.')
    missing = save_notes(out, checked)
    if missing:
        (out / 'notes.rejected.md').write_text(checked + '\n')
        raise Fail(f'The notes link to images that do not exist, so notes.md was not written: {", ".join(missing)}. '
                   f'The text is in {out}/notes.rejected.md')


def main():
    """Runs the command line.

    Returns:
        Process exit code.
    """
    parser = argparse.ArgumentParser(prog='vnotes', description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest='command', required=True)
    sub = commands.add_parser('fetch', help='write meta.json, transcript.txt and index sheets')
    sub.add_argument('url')
    sub.add_argument('dir')
    sub.add_argument('--transcribe', action='store_true', help='transcribe the audio even when captions exist')
    sub = commands.add_parser('frames', help='write 1080p frames and a contact sheet')
    sub.add_argument('dir')
    sub.add_argument('times', nargs='+', metavar='TIME', help='seconds, mm:ss or h:mm:ss')
    sub = commands.add_parser('notes', help='run the skill headless and write notes.md')
    sub.add_argument('url')
    sub.add_argument('--prompt', help='what you want from the notes')
    sub.add_argument('--agent', choices=['claude', 'codex'], default='claude')
    sub.add_argument('--out', metavar='DIR', help='folder to write into (default: notes-<video id>)')
    sub = commands.add_parser('direct', help='call a model in fixed steps and write notes.md')
    sub.add_argument('url')
    sub.add_argument('--via', required=True, choices=['chatgpt', 'openai', 'anthropic', 'openrouter', 'endpoint'],
                     help='the ChatGPT login Codex saved, or an API key from the environment')
    sub.add_argument('--model', help="model id (default: one per provider; required for 'endpoint')")
    sub.add_argument('--prompt', help='what you want from the notes')
    sub.add_argument('--out', metavar='DIR', help='folder to write into (default: notes-<video id>)')
    args = parser.parse_args()
    try:
        if not shutil.which('ffmpeg'):
            raise Fail('ffmpeg is not installed or not on PATH.')
        if args.command == 'fetch':
            fetch(args.url, args.dir, args.transcribe)
        elif args.command == 'frames':
            return frames(args.dir, args.times)
        elif args.command == 'direct':
            direct(args.url, args.prompt, args.via, args.model, args.out)
        else:
            notes(args.url, args.prompt, args.agent, args.out)
    except Fail as error:
        print(f'vnotes: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
