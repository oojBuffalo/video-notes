#!/usr/bin/env python3
"""Helper for the video-notes skill: fetch a transcript and index sheets, pull frames.

The agent that runs the skill reads, looks and writes. This script does the
fixed work around it. `vnotes direct` is the one part that calls a model
itself, in fixed steps.
"""
import argparse
import shutil
import sys

from video_notes.agent import notes
from video_notes.core import Fail, fetch, frames
from video_notes.direct import direct


def main():
    """Runs the command line.

    Returns:
        Process exit code.
    """
    parser = argparse.ArgumentParser(prog='vnotes', description=__doc__.splitlines()[0],
                                     epilog='Output settings: ~/.config/vnotes/config')
    commands = parser.add_subparsers(dest='command', required=True)
    sub = commands.add_parser('fetch', help='write meta.json, transcript.txt and index sheets')
    sub.add_argument('url')
    sub.add_argument('dir', nargs='?', help='exact output folder (overrides the configured folder)')
    sub.add_argument('--transcribe', action='store_true', help='transcribe the audio even when captions exist')
    sub = commands.add_parser('frames', help='write 1080p frames and a contact sheet')
    sub.add_argument('dir')
    sub.add_argument('times', nargs='+', metavar='TIME', help='seconds, mm:ss or h:mm:ss')
    sub = commands.add_parser('notes', help='run the skill headless and write Markdown notes')
    sub.add_argument('url')
    sub.add_argument('--prompt', help='what you want from the notes')
    sub.add_argument('--agent', choices=['claude', 'codex'], default='claude')
    sub.add_argument('--out', metavar='DIR', help='exact output folder (overrides the configured folder)')
    sub = commands.add_parser('direct', help='call a model in fixed steps and write Markdown notes')
    sub.add_argument('url')
    sub.add_argument('--via', required=True, choices=['chatgpt', 'openai', 'anthropic', 'openrouter', 'endpoint'],
                     help='the ChatGPT login Codex saved, or an API key from the environment')
    sub.add_argument('--model', help="model id (default: one per provider; required for 'endpoint')")
    sub.add_argument('--prompt', help='what you want from the notes')
    sub.add_argument('--out', metavar='DIR', help='exact output folder (overrides the configured folder)')
    args = parser.parse_args()
    try:
        if not shutil.which('ffmpeg'):
            raise Fail('ffmpeg is not installed or not on PATH.')
        if args.command == 'fetch':
            fetch(args.url, args.dir, args.transcribe)
        elif args.command == 'frames':
            return frames(args.dir, args.times)
        elif args.command == 'direct':
            direct(args.url, args.prompt, args.via, args.model, args.out)
        else:
            notes(args.url, args.prompt, args.agent, args.out)
    except (Fail, OSError) as error:
        print(f'vnotes: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
